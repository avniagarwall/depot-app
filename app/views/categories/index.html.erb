<% @categories.each do |category| %>
  <div>
    <strong><%= category.name %></strong>
    (<%= category.products_count %> products)

    <% if category.sub_categories.any? %>
      <ul>
        <% category.sub_categories.each do |sub| %>
          <li><%= sub.name %> (<%= sub.products_count %> products)</li>
        <% end %>
      </ul>
    <% end %>
  </div>
<% end %>