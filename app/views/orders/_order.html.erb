<div id="<%= dom_id order %>" class="w-full sm:w-auto my-5 space-y-5 border rounded p-4">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= order.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Address:</strong>
    <%= order.address %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Email:</strong>
    <%= order.email %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Pay type:</strong>
    <%= order.pay_type %>
  </div>

  <% if order.line_items.any? %>
    <div>
      <strong class="block font-medium mb-2">Items:</strong>
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-gray-100">
            <th class="text-left p-2">Product</th>
            <th class="text-right p-2">Qty</th>
            <th class="text-right p-2">Unit Price</th>
            <th class="text-right p-2">Subtotal</th>
          </tr>
        </thead>
        <tbody>
          <% order.line_items.each do |item| %>
            <tr class="border-t">
              <td class="p-2"><%= item.product.title %></td>
              <td class="text-right p-2"><%= item.quantity %></td>
              <td class="text-right p-2"><%= number_to_currency(item.product.price) %></td>
              <td class="text-right p-2"><%= number_to_currency(item.total_price) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr class="border-t font-bold">
            <td colspan="3" class="text-right p-2">Total:</td>
            <td class="text-right p-2">
              <%= number_to_currency(order.line_items.sum(&:total_price)) %>
            </td>
          </tr>
        </tfoot>
      </table>
    </div>
  <% end %>
</div>