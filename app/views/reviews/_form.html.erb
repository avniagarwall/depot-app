<% if review.errors.any? %>
  <div id="error_explanation">
    <h2>
      <%= pluralize(review.errors.count, "error") %>
      prohibited this review from being saved:
    </h2>
    <ul>
      <% review.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [@product, review] do |f| %>

  <div>
    <%= f.label :reviewer_name %>
    <%= f.text_field :reviewer_name %>
  </div>

  <div>
    <%= f.label :rating %>
    <%= f.select :rating, (1..5).to_a %>
  </div>

  <div>
    <%= f.label :body %>
    <%= f.text_area :body %>
  </div>

  <%= f.submit %>

<% end %>