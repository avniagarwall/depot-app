<% content_for :title, "Write a Review — #{@product.title}" %>

<div class="reviews-form-page">
  <h1 class="text-xl font-bold text-gray-800 mb-1">Write a Review</h1>
  <p class="text-gray-500 text-sm mb-6">for <strong><%= @product.title %></strong></p>

  <%= render partial: "reviews/form", locals: { review: @review, product: @product } %>

  <div class="mt-4">
    <%= link_to "← Cancel", product_reviews_path(@product),
        class: "text-sm text-gray-400 hover:underline" %>
  </div>
</div>