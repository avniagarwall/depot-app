<%# Partial locals, safe navigation, counter variable %>
<li class="review-card <%= 'review-card--highlighted' if highlight %>
                        <%= 'review-card--first' if defined?(review_counter) && review_counter == 0 %>">
  <div class="review-header">
    <% if review.category.present? %>
      <span class="review-tag review-tag--<%= review.category %>">
        <%= review.category.upcase %>
      </span>
    <% else %>
      <span class="review-tag review-tag--uncategorized">UNCATEGORIZED</span>
    <% end %>

    <% if defined?(review_counter) %>
      <span class="review-counter">#<%= review_counter + 1 %></span>
    <% end %>

    <h3 class="review-title"><%= review.title %></h3>
  </div>

  <div class="review-meta">
    <span class="review-author">by <%= review.reviewer_name.presence || "Anonymous" %></span>
    <% if review.rating.present? %>
      <span class="review-rating">
        <%= "⭐" * review.rating.to_i %> (<%= review.rating %>/5)
      </span>
    <% end %>
  </div>

  <p class="review-body"><%= review.body %></p>

  <div class="review-footer">
    <span class="review-date text-gray-400 text-xs">
      <%= review.created_at.strftime("%b %d, %Y") %>
    </span>
  </div>
</li>