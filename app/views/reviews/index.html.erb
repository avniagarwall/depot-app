<% content_for :title, "Reviews for #{@product.title}" %>

<div class="reviews-index">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
    <h1 class="text-2xl font-bold text-gray-800">
      Reviews <span class="text-base font-normal text-gray-400">for <%= @product.title %></span>
    </h1>
    <div>
      <%= link_to "← Back to Product", store_show_path(@product),
          class: "text-sm text-gray-500 hover:underline" %>
      <%= link_to "✍️ Write a Review", new_product_review_path(@product),
          class: "px-4 py-2 text-sm bg-amber-100 text-amber-800 border border-amber-300 rounded hover:bg-amber-200 transition ml-4" %>
    </div>
  </div>

  <% if notice %>
    <div class="bg-green-50 border border-green-200 text-green-800 rounded px-4 py-2 text-sm mb-4">
      <%= notice %>
    </div>
  <% end %>

  <ul class="review-list">
    <%= render(partial: "reviews/review",
               collection: @reviews,
               as: :review,
               locals: { highlight: false },
               spacer_template: "reviews/review_separator") ||
        content_tag(:li, "No reviews yet — be the first!", class: "text-sm text-gray-400 italic py-4") %>
  </ul>
</div>