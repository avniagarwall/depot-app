<div class="mx-auto md:w-2/3 w-full flex flex-col px-8">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice">
      <%= notice %>
    </p>
  <% end %>

  <h1 class="font-bold text-4xl mb-4"><%= @product.title %></h1>
  <p class="text-sm text-gray-500 mb-2"><%= @product.category&.name %></p>
  <p class="mb-4"><%= sanitize(@product.description) %></p>

  <div class="mb-4">
    <% if @product.discount_price.present? && @product.discount_price < @product.price %>
      <span class="line-through text-gray-400 mr-2"><%= number_to_currency(@product.price) %></span>
      <span class="font-bold text-lg text-green-600"><%= number_to_currency(@product.discount_price) %></span>
    <% else %>
      <span class="font-bold text-lg"><%= number_to_currency(@product.price) %></span>
    <% end %>
  </div>

  <%= button_to "Add to Cart",
      line_items_path(product_id: @product),
      form_class: "inline mb-6",
      class: "rounded-lg py-1 px-2 text-white bg-green-600" %>

  <%# Image slider %>
  <% if @product.images.attached? %>
    <div class="mt-6">
      <strong class="block font-medium mb-3">Images:</strong>
      <div class="relative">
        <% @product.images.each_with_index do |img, i| %>
          <div class="slide" style="display: <%= i.zero? ? 'block' : 'none' %>">
            <%= image_tag img, class: "w-full max-w-md h-64 object-cover rounded shadow" %>
          </div>
        <% end %>

        <% if @product.images.count > 1 %>
          <div class="flex gap-4 mt-4">
            <button onclick="changeSlide(-1)"
                    class="px-4 py-2 bg-gray-200 rounded hover:bg-gray-300">
              &#8592; Prev
            </button>
            <button onclick="changeSlide(1)"
                    class="px-4 py-2 bg-gray-200 rounded hover:bg-gray-300">
              Next &#8594;
            </button>
          </div>
        <% end %>
      </div>
    </div>

    <script>
      let current = 0;
      const slides = document.querySelectorAll(".slide");

      function changeSlide(direction) {
        slides[current].style.display = "none";
        current = (current + direction + slides.length) % slides.length;
        slides[current].style.display = "block";
      }
    </script>
  <% end %>

  <% if Current.session&.user&.admin? %>
    <div class="flex gap-4 mt-8">
      <%= link_to "Edit this product", edit_product_path(@product),
          class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
      <%= link_to "Back to products", products_path,
          class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
      <%= button_to "Destroy this product", @product, method: :delete,
          class: "rounded-lg py-3 px-5 bg-red-600 text-white font-medium",
          data: { turbo_confirm: I18n.t("helpers.confirm.destroy") } %>
    </div>
  <% end %>
</div>