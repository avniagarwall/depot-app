<%= turbo_frame_tag(dom_id(product)) do %>
  <li class="flex mb-6">
    <% if product.images.attached? %>
      <%= image_tag product.images.first, class: "object-contain w-40 h-48 shadow mr-6" %>
    <% else %>
      <div class="w-40 h-48 shadow mr-6 bg-gray-100 flex items-center justify-center">
        <span class="text-gray-400 text-sm">No image</span>
      </div>
    <% end %>

    <div>
      <h2 class="font-bold text-lg mb-3"><%= product.title %></h2>

      <p class="text-sm text-gray-500 mb-1"><%= product.category&.name %></p>

      <p><%= sanitize(product.description) %></p>

      <div class="mt-3">
        <%= number_to_currency(product.price) %>

        <%= button_to t(".add_html"),
            line_items_path(product_id: product),
            form_class: "inline",
            class: "ml-4 rounded-lg py-1 px-2 text-white bg-green-600" %>
      </div>
    </div>
  </li>
<% end %>
