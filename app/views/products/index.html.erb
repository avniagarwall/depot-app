<%= turbo_stream_from "products" %>
<%= turbo_refreshes_with method: :morph, scroll: :preserve %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice">
      <%= notice %>
    </p>
  <% end %>

  <div class="flex justify-between items-center pb-8">
    <h1 class="mx-auto font-bold text-4xl">Products</h1>
  </div>

  <table id="products" class="mx-auto">
    <tfoot>
      <tr>
        <td colspan="3">
          <div class="mt-8">
            <%= link_to "New product", new_product_path,
                class: "inline rounded-lg py-3 px-5 bg-green-600 text-white block font-medium" %>
          </div>
        </td>
      </tr>
    </tfoot>

    <tbody>
      <% @products.each do |product| %>
        <tr class="<%= cycle("bg-green-50", "bg-white") %>">
          <td class="px-2 py-3">
            <% if product.images.attached? %>
              <%= image_tag product.images.first, class: "w-40 h-40 object-cover rounded" %>
            <% else %>
              <span class="text-gray-400 text-sm">No image</span>
            <% end %>
          </td>

          <td class="px-3 py-3">
            <h2 class="text-xl font-bold"><%= product.title %></h2>
            <p class="text-sm text-gray-500 mb-1"><%= product.category&.name %></p>
            <p class="my-3"><%= truncate(strip_tags(product.description), length: 80) %></p>
            <p><%= number_to_currency(product.price) %></p>
            <% if product.tags.any? %>
              <div class="flex flex-wrap gap-1 mt-2">
                <% product.tags.each do |tag| %>
                  <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                    <%= tag.name %>
                  </span>
                <% end %>
              </div>
            <% end %>
          </td>

          <td class="px-3 py-3">
            <ul class="space-y-1">
              <li><%= link_to "Show",    product,                  class: "hover:underline" %></li>
              <li><%= link_to "Edit",    edit_product_path(product), class: "hover:underline" %></li>
              <li>
                <%= button_to "Destroy", product, method: :delete,
                    class: "hover:underline",
                    data: { turbo_confirm: I18n.t("helpers.confirm.destroy") } %>
              </li>
            </ul>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>