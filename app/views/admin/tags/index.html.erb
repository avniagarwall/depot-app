<div class="w-full">

  <%# ── Page heading ── %>
  <div class="flex justify-between items-center pb-6">
    <h1 class="font-bold text-4xl">Tags</h1>
  </div>

  <%# ── Flash messages ── %>
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-4 text-green-600 font-medium rounded-lg inline-block">
      <%= notice %>
    </p>
  <% end %>
  <% if alert.present? %>
    <p class="py-2 px-3 bg-red-50 mb-4 text-red-500 font-medium rounded-lg inline-block">
      <%= alert %>
    </p>
  <% end %>

  <%# ── Create new tag ── %>
  <%= form_with url: admin_tags_path, method: :post, class: "flex gap-2 mb-8" do %>
    <input
      type="text"
      name="name"
      placeholder="New tag name…"
      required
      class="block shadow-sm rounded-md border border-gray-400 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-600 w-64"
    >
    <button type="submit"
      class="rounded-md px-4 py-2 bg-green-600 hover:bg-green-500 text-white text-sm font-medium">
      Add Tag
    </button>
  <% end %>

  <% if @tags.any? %>

    <%# ── Tag filter pills ── %>
    <div class="flex flex-wrap gap-2 mb-6">
      <%= link_to "All Tags", admin_tags_path,
          class: "px-3 py-1 rounded-full text-sm font-medium transition #{params[:tag].blank? ? 'bg-green-700 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
      <% @tags.each do |tag| %>
        <%= link_to "#{tag.name} (#{tag.products.size})", admin_tags_path(tag: tag.name),
            class: "px-3 py-1 rounded-full text-sm font-medium transition #{params[:tag] == tag.name ? 'bg-green-700 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
      <% end %>
    </div>

    <%# ── Tags management table ── %>
    <table class="w-full border-collapse">
      <thead>
        <tr class="bg-green-700 text-white">
          <th class="px-4 py-3 text-left">Name</th>
          <th class="px-4 py-3 text-left">Products</th>
          <th class="px-4 py-3 text-left">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @tags.each do |tag| %>
          <tr class="<%= cycle('bg-green-50', 'bg-white') %> border-b">
            <td class="px-4 py-3">
              <%= link_to tag.name, admin_tags_path(tag: tag.name),
                  class: "text-green-700 hover:underline font-medium" %>
            </td>
            <td class="px-4 py-3 text-gray-600"><%= tag.products.size %></td>
            <td class="px-4 py-3">
              <%= button_to "Delete", admin_tag_path(tag), method: :delete,
                  class: "text-red-500 hover:underline text-sm",
                  data: { turbo_confirm: "Delete '#{tag.name}'? It will be removed from all products." } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%# ── Products for selected tag ── %>
    <% if @selected_tag %>
      <div class="border-t pt-8">
        <div class="flex items-center gap-3 mb-6">
          <h2 class="font-bold text-2xl">
            Products tagged
            <span class="text-green-700">"<%= @selected_tag.name %>"</span>
          </h2>
          <span class="text-gray-400 text-lg">(<%= @products.size %>)</span>
          <%= link_to "Clear", admin_tags_path,
              class: "ml-2 text-sm text-red-400 hover:underline" %>
        </div>

        <% if @products.any? %>
          <table class="w-full border-collapse">
            <thead>
              <tr class="bg-green-700 text-white">
                <th class="px-4 py-3 text-left">Image</th>
                <th class="px-4 py-3 text-left">Product</th>
                <th class="px-4 py-3 text-left">Tags</th>
                <th class="px-4 py-3 text-left">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @products.each do |product| %>
                <tr class="<%= cycle('bg-green-50', 'bg-white') %> border-b">
                  <td class="px-4 py-3">
                    <% if product.images.attached? %>
                      <%= image_tag product.images.first,
                          class: "w-16 h-16 object-cover rounded" %>
                    <% else %>
                      <span class="text-gray-400 text-sm">No image</span>
                    <% end %>
                  </td>

                  <td class="px-4 py-3">
                    <p class="font-bold"><%= product.title %></p>
                    <p class="text-sm text-gray-500"><%= product.category&.name %></p>
                    <p class="text-sm font-medium mt-1"><%= number_to_currency(product.price) %></p>
                  </td>

                  <td class="px-4 py-3">
                    <div class="flex flex-wrap gap-1">
                      <% product.tags.each do |tag| %>
                        <%= link_to tag.name, admin_tags_path(tag: tag.name),
                            class: "inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 hover:bg-blue-200" %>
                      <% end %>
                    </div>
                  </td>

                  <td class="px-4 py-3">
                    <ul class="space-y-1 text-sm">
                      <li>
                        <%= link_to "Edit", edit_product_path(product),
                            class: "hover:underline" %>
                      </li>
                      <li>
                        <%= button_to "Delete", product, method: :delete,
                            class: "text-red-500 hover:underline",
                            data: { turbo_confirm: I18n.t("helpers.confirm.destroy") } %>
                      </li>
                    </ul>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>

        <% else %>
          <p class="text-gray-500">No products with this tag yet.</p>
        <% end %>
      </div>
    <% end %>

  <% else %>
    <p class="text-gray-500 mt-4">
      No tags yet. Use the form above to create your first tag.
    </p>
  <% end %>

</div>