<h1 class="text-2xl font-bold mb-4">All Categories</h1>

<table class="w-full text-sm border">
  <thead>
    <tr class="bg-gray-100">
      <th class="text-left p-2">Category Name</th>
      <th class="text-left p-2">Parent Category</th>
      <th class="text-right p-2">Total Products</th>
    </tr>
  </thead>
  <tbody>
    <% @categories.each do |category| %>
      <tr class="border-t">
        <td class="p-2">
          <%= link_to category.name, category_books_path(category),
                class: "text-blue-600 hover:underline" %>
        </td>
        <td class="p-2">—</td>
        <td class="text-right p-2"><%= category.products_count %></td>
      </tr>
      <% category.sub_categories.each do |sub| %>
        <tr class="border-t bg-gray-50">
          <td class="p-2 pl-6"><%= sub.name %></td>
          <td class="p-2"><%= category.name %></td>
          <td class="text-right p-2"><%= sub.products.count %></td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>