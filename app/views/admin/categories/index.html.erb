<h1 class="text-2xl font-bold mb-6">Categories</h1>

<table class="w-full border-collapse">
  <thead>
    <tr class="bg-gray-100">
      <th class="px-4 py-2 text-left">Category Name</th>
      <th class="px-4 py-2 text-left">Parent Category</th>
      <th class="px-4 py-2 text-left">Total Products</th>
    </tr>
  </thead>
  <tbody>
    <% @categories.each do |category| %>
      <tr class="<%= cycle('bg-white', 'bg-gray-50') %> border-t">
        <td class="px-4 py-2">
          <%= link_to category.name, category_books_path(category),
              class: "text-blue-600 hover:underline" %>
        </td>
        <td class="px-4 py-2"><%= category.parent&.name || "—" %></td>
        <td class="px-4 py-2">
          <%= category.products.count + category.sub_category_products.count %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>