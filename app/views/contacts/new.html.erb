<h1>Contact Us</h1>

<% if @contact_form.errors.any? %>
  <div id="error_explanation">
    <h2>
      <%= pluralize(@contact_form.errors.count, "error") %>
      prevented this message from being sent:
    </h2>
    <ul>
      <% @contact_form.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @contact_form, url: contacts_path do |f| %>

  <div>
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :email %>
    <%= f.email_field :email %>
  </div>

  <div>
    <%= f.label :subject %>
    <%= f.select :subject, %w(billing technical general),
          { prompt: "Select a subject" } %>
  </div>

  <div>
    <%= f.label :message %>
    <%= f.text_area :message, rows: 5 %>
  </div>

  <%= f.submit "Send Message" %>

<% end %>