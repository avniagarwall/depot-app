<% content_for :title, "My Orders" %>

<div class="w-full">
  <h2 class="font-bold text-4xl mb-6">My Orders</h2>

  <% if @orders.empty? %>
    <p class="text-center my-10 text-gray-500">You have no orders yet.</p>
  <% else %>
    <div class="space-y-4">
      <% @orders.each do |order| %>
        <div class="bg-white rounded-lg shadow p-5">
          <div class="flex justify-between items-center mb-3">
            <span class="font-semibold text-gray-700">Order #<%= order.id %></span>
            <span class="text-sm text-gray-500"><%= order.created_at.strftime("%b %d, %Y") %></span>
          </div>

          <table class="min-w-full text-sm divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="text-left px-3 py-2 font-semibold">Product</th>
                <th class="text-right px-3 py-2 font-semibold">Qty</th>
                <th class="text-right px-3 py-2 font-semibold">Price</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% order.line_items.each do |item| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-3 py-2"><%= item.product.title %></td>
                  <td class="text-right px-3 py-2"><%= item.quantity %></td>
                  <td class="text-right px-3 py-2"><%= number_to_currency(item.product.price) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>

          <div class="mt-3 text-right font-semibold text-gray-800">
            Total: <%= number_to_currency(order.line_items.sum { |i| i.total_price }) %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>